# Copy to .env for local development. .env is gitignored — never commit real
# values. Vite only exposes VITE_*-prefixed vars to client code.

# ── Supabase (required) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Sentry, runtime (optional) ───────────────────────────────────────────────
# Without a DSN, initSentry() is a no-op — local dev and CI stay silent. Set
# this in Vercel for production. The org is EU-region, so the DSN host is
# *.ingest.de.sentry.io, which must also appear in the connect-src CSP
# directive in web/vercel.json.
VITE_SENTRY_DSN=

# Overrides the release name. Normally left unset: production builds derive it
# from Vercel's VERCEL_GIT_COMMIT_SHA (see vite.config.js).
VITE_SENTRY_RELEASE=

# ── Sentry, build-time (Vercel production only) ──────────────────────────────
# Present together, these switch on hidden source maps and upload them, so
# stack traces show original source instead of minified frames. Absent, the
# vite plugin is omitted entirely.
SENTRY_ORG=splitiq-29
SENTRY_PROJECT=erg-dashboard
SENTRY_URL=https://de.sentry.io
# Org auth token with Project: Read & Write + Release: Admin. Never commit.
SENTRY_AUTH_TOKEN=
