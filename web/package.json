{
  "name": "splitiq",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "size": "node scripts/check-bundle-size.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "lint": "eslint src/ scripts/",
    "format": "prettier --write src/ scripts/",
    "format:check": "prettier --check src/ scripts/",
    "check:zones": "node scripts/check-zone-bands.mjs",
    "check:design-sync": "node scripts/check-design-sync-entry.mjs",
    "check:colours": "node scripts/check-colour-literals.mjs",
    "check:context7": "node scripts/check-context7.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.0",
    "@capgo/capacitor-bluetooth-low-energy": "^8.2.7",
    "@sentry/react": "^10.75.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^5.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
