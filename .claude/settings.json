{
  "worktree": { "baseRef": "fresh" },
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run size)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run check:zones)",
      "Bash(npm run check:design-sync)",
      "Bash(npm run check:colours)",
      "Bash(npm run check:context7)",
      "Bash(npm run test:e2e)",
      "Bash(npx vitest run *)",
      "Bash(npm --prefix web test *)",
      "Bash(npm --prefix web run lint)",
      "Bash(npm --prefix web run build)",
      "Bash(npm --prefix web run format:check)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list)",
      "Bash(git branch --show-current)",
      "Bash(git fetch *)",
      "Bash(deno run --allow-env vitals-import/test.ts)",
      "Bash(deno run --allow-env vitals-import-api/test.ts)",
      "Bash(deno run --allow-env strava-import/test.ts)",
      "mcp__Supabase__list_tables",
      "mcp__Supabase__list_migrations",
      "mcp__Supabase__get_advisors",
      "mcp__Context7__resolve-library-id",
      "mcp__Context7__query-docs",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__get_job_logs"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(rm *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/block-secret-commit.sh" },
          { "type": "command", "command": "echo '[HOOK] Bash command about to run. If this is git reset --hard, git push --force, or rm -rf — stop and confirm with the user first.'" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited-file.sh\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/warn-uncommitted.sh\"" }
        ]
      }
    ]
  }
}
